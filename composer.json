{
    "name": "iwf/craft-control-panel-element-counter",
    "description": "Control Panel Element Counter",
    "type": "craft-plugin",
    "keywords": [
        "craft-cms",
        "craft-cp",
        "craft-control-panel",
        "element-counter",
        "plugin"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stefan Friedrich",
            "email": "s.friedrich@iwf.ch",
            "homepage": "https://github.com/stefanfriedrich",
            "role": "Maintainer"
        }
    ],
    "support": {
        "email": "s.friedrich@iwf.ch",
        "issues": "https://github.com/iwf-web/craft-cp-element-counter/issues",
        "forum": "https://github.com/iwf-web/craft-cp-element-counter/discussions",
        "wiki": "https://github.com/iwf-web/craft-cp-element-counter/wiki",
        "source": "https://github.com/iwf-web/craft-cp-element-counter",
        "docs": "https://github.com/iwf-web/craft-cp-element-counter",
        "rss": "https://github.com/iwf-web/craft-cp-element-counter/releases.atom"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-alpha.20"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "friendsofphp/php-cs-fixer": "^3.88",
        "iwf-web/php-coding-standard": "^1.0",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "cpelementcounter\\": "src/"
        }
    },
    "extra": {
        "handle": "control-panel-element-counter",
        "name": "Control Panel Element Counter",
        "developer": "IWF",
        "developerUrl": "https://www.iwf.ch/web-solutions",
        "documentationUrl": "https://github.com/iwf-web/craft-cp-element-counter",
        "class": "cpelementcounter\\CpElementCounter"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "cs": "php-cs-fixer fix --dry-run --diff -v",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    }
}
